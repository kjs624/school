# Supabase 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# 로그인에 쓰는 계정 이메일 (Supabase Authentication 에서 직접 만든 사용자)
OWNER_EMAIL=you@example.com

# Vercel Cron 이 keepalive 를 호출할 때 쓰는 비밀 값 (아무 긴 문자열)
CRON_SECRET=change-me-to-a-long-random-string
